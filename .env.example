# Compose publishes port 3000 on this host address.
ZBIERAK_PUBLISH_ADDRESS=127.0.0.1

# Application listener and persistent SQLite database.
ZBIERAK_LISTEN_ADDR=0.0.0.0:3000
ZBIERAK_DATABASE_URL=sqlite:///data/zbierak.db?mode=rwc

# Use true behind HTTPS. Accepted values: true/false, 1/0, yes/no.
ZBIERAK_COOKIE_SECURE=false

# Valid range: 1 through 365 days.
ZBIERAK_SESSION_DAYS=30

# Optional runtime asset overrides. Templates and static assets are embedded
# in the binary, so these are only needed to override them from disk. A
# variable naming a missing directory falls back to the embedded assets with
# a warning.
# ZBIERAK_STATIC_DIR=/app/static
# ZBIERAK_TEMPLATE_DIR=/app/templates

# Master key encrypting webhook signing secrets at rest. Required before
# webhook-kind endpoints can be created. Generate one with:
#   openssl rand -base64 32
ZBIERAK_SECRET_KEY=

# tracing-subscriber EnvFilter syntax.
RUST_LOG=zbierak=info
